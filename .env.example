# 复制成 .env 后填写。这个文件只放**密钥**，行为开关放 config.json。
#
# --- 方式一：永久 AK/SK（基线模式，最少配置就能跑） ---
CODEARTS_AK=你的AccessKey
CODEARTS_SK=你的SecretKey

# --- 方式二：OAuth（推荐，可自动续期） ---
# 不填 AK/SK，改成先执行 `python login.py`（或启动后在 WebUI 点「＋ 授权登录」），
# 凭证会落到 auths/codearts-{user_id}.json。
# 两种方式可以同时存在，config.json 的 mode 决定用哪些：auto（默认，都用）/ apikey / oauth。

# --- 必填：访问密钥 ---
# 没有它服务会拒绝启动（基线是任意字符串都能调，等于裸奔）。
# 生成：python -c "import secrets;print(secrets.token_hex(24))"
CA2A_API_KEY=

# --- 可选：监听地址（默认 127.0.0.1:8787，与基线一致） ---
# CA2A_LISTEN_HOST=127.0.0.1
# CA2A_LISTEN_PORT=8787
# 基线变量名同样生效：
# CODEARTS_PROXY_HOST=127.0.0.1
# CODEARTS_PROXY_PORT=8787

# --- 可选：常用开关（完整清单见 README 的配置项表） ---
# CA2A_MODE=auto
# CA2A_DEFAULT_MODEL=glm-5.2
# CA2A_MAX_CONCURRENT=2
# CA2A_WATCH_ENABLED=1
# CA2A_CREDITS_AUTO_CLAIM=1
# CA2A_BENEFIT_AUTO_CLAIM=1
# CA2A_LOGIN_CLIENT_ID=codearts-agent
